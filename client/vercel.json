{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://kennystores-api-5f26.onrender.com/api/:path*"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Credentials", "value": "true" },
                { "key": "Access-Control-Allow-Origin", "value": "https://kenny-stores-market-place.vercel.app" },
                { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PATCH,DELETE,OPTIONS" },
                { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
            ]
        }
    ]
}